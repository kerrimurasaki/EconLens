# Local Postgres (docker compose up -d db)
DATABASE_URL="postgresql://econlens:econlens@localhost:5432/econlens?schema=public"
# Generate with: openssl rand -base64 32. Production refuses to start with a short or "change-me" value.
NEXTAUTH_SECRET="change-me-in-real-environments"
NEXTAUTH_URL="http://localhost:3000"

# AI (M2). Leave empty to use the labelled demo-fixture provider.
AI_PROVIDER="demo"
OPENAI_API_KEY=""
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
